# Server
NODE_ENV=development
PORT=3000
FEISHU_EVENT_MODE=ws
PUBLIC_BASE_URL=

# Feishu/Lark app
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_APP_DOMAIN=feishu
FEISHU_APP_ENCRYPT_KEY=
FEISHU_APP_VERIFICATION_TOKEN=

# Security
# Use the user_id shown by Feishu Open Platform events. Separate multiple IDs with commas.
ALLOWED_FEISHU_USER_IDS=user_xxx
# Whitelisted project roots. Use semicolon on Windows, for example:
# PROJECT_WHITELIST=C:\Users\me\repo1;D:\work\repo2
PROJECT_WHITELIST=C:\path\to\your\project
# Optional: when set, new sessions start here without /start, and restart resets sessions here.
DEFAULT_PROJECT_PATH=

# Agent runner
DEFAULT_RUNNER=codex
TASK_TIMEOUT_MS=900000
SUMMARY_INTERVAL_MS=30000
STREAM_UPDATE_INTERVAL_MS=3000
DANGEROUS_APPROVAL_ENABLED=true

# Codex runner
# Default mode calls: codex exec --json --cd <project_path> --sandbox workspace-write <task>
# Follow-up messages call: codex exec resume --json <thread_id> <task>
CODEX_BIN=codex
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL_POLICY=on-request
CODEX_EXTRA_ARGS=--disable plugins

# Video message analysis. 3-5 minute videos at 1 fps become 180-300 frames.
# FFMPEG_BIN must point to ffmpeg if it is not on PATH.
FFMPEG_BIN=ffmpeg
VIDEO_FRAME_INTERVAL_SECONDS=1
VIDEO_MAX_FRAMES=300
VIDEO_FRAME_WIDTH=1280
VIDEO_CODEX_BATCH_SIZE=20

# Attachment cache cleanup
ATTACHMENT_DIR=./data/attachments
ATTACHMENT_RETENTION_HOURS=24
ATTACHMENT_CLEANUP_INTERVAL_MINUTES=60

# Claude Code runner
CLAUDE_BIN=claude
# print uses: claude -p "<task>"
# bare uses: claude --bare "<task>"
CLAUDE_MODE=print
CLAUDE_EXTRA_ARGS=

# Optional Codex app-server runner endpoint.
# Leave empty to use Codex CLI. Set this only when you have a compatible app-server endpoint.
CODEX_APP_SERVER_URL=
CODEX_APP_SERVER_TOKEN=

# Local failure-report API. Required for POST /agent/report.
REPORT_TOKEN=change_me_to_a_random_token
REPORT_MAX_BODY_BYTES=262144

# SQLite
SQLITE_PATH=./data/gateway.sqlite
